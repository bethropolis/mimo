{
	"name": "playground",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"bundles": "mkdir -p ./static && bun build ./scripts/web-entry.js --format esm --target browser --outfile ./static/mimo-web.bundle.js",
		"dev": "bun run bundles && vite dev",
		"build": "bun run bundles && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^8.3.5"
	},
	"dependencies": {
		"@codemirror/lint": "^6.9.7",
		"@lucide/svelte": "^1.61.0",
		"@zenfs/core": "^2.8.0",
		"@zenfs/dom": "^1.2.14",
		"svelte-codemirror-editor": "^2.1.0",
		"@codemirror/autocomplete": "^6.20.4",
		"@codemirror/language": "^6.13.1",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@lezer/highlight": "^1.2.5"
	}
}
